From c57874850f1a83e905acdb4171574ef49bc9fee6 Mon Sep 17 00:00:00 2001
From: Cheng-Yang Chou <yphbchou0911@gmail.com>
Date: Fri, 23 Oct 2026 15:38:48 +0000
Subject: [PATCH sched_ext/for-7.5 6/7] selftests/sched_ext: Fix link leaks in
 create_dsq, maximal and prog_run
To: Tejun Heo <tj@kernel.org>
Cc: David Vernet <void@manifault.com>,
    Andrea Righi <arighi@nvidia.com>,
    Changwoo Min <changwoo@igalia.com>,
    Tao Cui <cuitao@kylinos.cn>,
    Ching-Chun Huang <jserv@ccns.ncku.edu.tw>,
    Chia-Ping Tsai <chia7712@gmail.com>,
    sched-ext@lists.linux.dev,
    linux-kernel@vger.kernel.org

SCX_ASSERT_ALIVE() and EXIT_KIND() return from the calling function on
failure. create_dsq and maximal call SCX_ASSERT_ALIVE() after attaching
the scheduler and before destroying the link, and prog_run calls
EXIT_KIND() there, so a failing check leaves the scheduler loaded for
the tests that follow.

Convert create_dsq and maximal to the test context helpers so that
cleanup() destroys the link, and resolve the exit kind in prog_run
before attaching.

Fixes: bb905626a48c ("selftests/sched_ext: Add SCX_ASSERT_ALIVE and adopt it")
Fixes: 0aeb67fee3ca ("selftests/sched_ext: Fail loudly when EXIT_KIND is missing from BTF")
Signed-off-by: Cheng-Yang Chou <yphbchou0911@gmail.com>
---
 .../testing/selftests/sched_ext/create_dsq.c  | 38 ++++--------------
 tools/testing/selftests/sched_ext/maximal.c   | 39 ++++++++-----------
 tools/testing/selftests/sched_ext/prog_run.c  |  4 +-
 3 files changed, 26 insertions(+), 55 deletions(-)

diff --git a/tools/testing/selftests/sched_ext/create_dsq.c b/tools/testing/selftests/sched_ext/create_dsq.c
index 84143d5710f4..427df829daf8 100644
--- a/tools/testing/selftests/sched_ext/create_dsq.c
+++ b/tools/testing/selftests/sched_ext/create_dsq.c
@@ -10,47 +10,23 @@
 #include "create_dsq.bpf.skel.h"
 #include "scx_test.h"
 
-static enum scx_test_status setup(void **ctx)
-{
-	struct create_dsq *skel;
-
-	skel = create_dsq__open();
-	SCX_FAIL_IF(!skel, "Failed to open");
-	SCX_ENUM_INIT(skel);
-	SCX_FAIL_IF(create_dsq__load(skel), "Failed to load skel");
-
-	*ctx = skel;
-
-	return SCX_TEST_PASS;
-}
+SCX_TEST_DEFINE_CTX(create_dsq)
 
 static enum scx_test_status run(void *ctx)
 {
-	struct create_dsq *skel = ctx;
-	struct bpf_link *link;
+	struct create_dsq_ctx *tctx = ctx;
 
-	link = bpf_map__attach_struct_ops(skel->maps.create_dsq_ops);
-	if (!link) {
-		SCX_ERR("Failed to attach scheduler");
-		return SCX_TEST_FAIL;
-	}
+	SCX_TEST_ATTACH(tctx, create_dsq_ops);
+	SCX_ASSERT_ALIVE(tctx->skel, uei);
 
-	SCX_ASSERT_ALIVE(skel, uei);
+	bpf_link__destroy(tctx->link);
+	tctx->link = NULL;
 
-	bpf_link__destroy(link);
-
-	SCX_EQ(skel->bss->nr_lifecycle_tests, 1024);
+	SCX_EQ(tctx->skel->bss->nr_lifecycle_tests, 1024);
 
 	return SCX_TEST_PASS;
 }
 
-static void cleanup(void *ctx)
-{
-	struct create_dsq *skel = ctx;
-
-	create_dsq__destroy(skel);
-}
-
 struct scx_test create_dsq = {
 	.name = "create_dsq",
 	.description = "Create, reject duplicates, destroy and recreate DSQs",
diff --git a/tools/testing/selftests/sched_ext/maximal.c b/tools/testing/selftests/sched_ext/maximal.c
index 6c6b80e0446e..f67360d55223 100644
--- a/tools/testing/selftests/sched_ext/maximal.c
+++ b/tools/testing/selftests/sched_ext/maximal.c
@@ -10,45 +10,38 @@
 #include "maximal.bpf.skel.h"
 #include "scx_test.h"
 
+SCX_TEST_DEFINE_CTX_TYPE(maximal);
+SCX_TEST_DEFINE_CLEANUP(maximal)
+
 static enum scx_test_status setup(void **ctx)
 {
-	struct maximal *skel;
+	struct maximal_ctx *tctx;
 
-	skel = maximal__open();
-	SCX_FAIL_IF(!skel, "Failed to open");
-	SCX_ENUM_INIT(skel);
-	SCX_FAIL_IF(maximal__load(skel), "Failed to load skel");
+	SCX_TEST_OPEN(tctx, maximal);
+	SCX_TEST_LOAD(tctx, maximal);
 
-	bpf_map__set_autoattach(skel->maps.maximal_ops, false);
-	SCX_FAIL_IF(maximal__attach(skel), "Failed to attach skel");
+	bpf_map__set_autoattach(tctx->skel->maps.maximal_ops, false);
+	if (maximal__attach(tctx->skel)) {
+		maximal__destroy(tctx->skel);
+		free(tctx);
+		SCX_FAIL("Failed to attach skel");
+	}
 
-	*ctx = skel;
+	*ctx = tctx;
 
 	return SCX_TEST_PASS;
 }
 
 static enum scx_test_status run(void *ctx)
 {
-	struct maximal *skel = ctx;
-	struct bpf_link *link;
-
-	link = bpf_map__attach_struct_ops(skel->maps.maximal_ops);
-	SCX_FAIL_IF(!link, "Failed to attach scheduler");
+	struct maximal_ctx *tctx = ctx;
 
-	SCX_ASSERT_ALIVE(skel, uei);
-
-	bpf_link__destroy(link);
+	SCX_TEST_ATTACH(tctx, maximal_ops);
+	SCX_ASSERT_ALIVE(tctx->skel, uei);
 
 	return SCX_TEST_PASS;
 }
 
-static void cleanup(void *ctx)
-{
-	struct maximal *skel = ctx;
-
-	maximal__destroy(skel);
-}
-
 struct scx_test maximal = {
 	.name = "maximal",
 	.description = "Verify we can load a scheduler with every callback defined",
diff --git a/tools/testing/selftests/sched_ext/prog_run.c b/tools/testing/selftests/sched_ext/prog_run.c
index 369c744ac06e..2f83cb6662db 100644
--- a/tools/testing/selftests/sched_ext/prog_run.c
+++ b/tools/testing/selftests/sched_ext/prog_run.c
@@ -30,6 +30,8 @@ static enum scx_test_status run(void *ctx)
 	struct prog_run *skel = ctx;
 	struct bpf_link *link = NULL;
 	enum scx_test_status status = SCX_TEST_PASS;
+	/* EXIT_KIND() returns on failure, so resolve it before attaching */
+	u64 unreg_bpf = EXIT_KIND(SCX_EXIT_UNREG_BPF);
 	int prog_fd, err = 0;
 
 	prog_fd = bpf_program__fd(skel->progs.prog_run_syscall);
@@ -61,7 +63,7 @@ static enum scx_test_status run(void *ctx)
 		goto out;
 	}
 
-	if (skel->data->uei.kind != EXIT_KIND(SCX_EXIT_UNREG_BPF)) {
+	if (skel->data->uei.kind != unreg_bpf) {
 		SCX_ERR("Unexpected exit kind: %llu",
 			(unsigned long long)skel->data->uei.kind);
 		status = SCX_TEST_FAIL;
-- 
2.56.0

