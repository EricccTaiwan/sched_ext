 			SCX_BUG_ON(ret, "Failed to set sched to sched_ext");
@@ -100,54 +154,59 @@ static enum scx_test_status run_test(bool global)
 			}
 			exit(0);
 		}
+		if (pids[i] > 0)
+			nforked++;
