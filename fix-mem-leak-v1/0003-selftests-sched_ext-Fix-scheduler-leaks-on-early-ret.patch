 	while (!UEI_EXITED(skel, uei))
 		sched_yield();
 
-	SCX_EQ(skel->data->uei.kind, kind);
-	SCX_EQ(UEI_REPORT(skel, uei), code);
+	if (skel->data->uei.kind != kind) {
