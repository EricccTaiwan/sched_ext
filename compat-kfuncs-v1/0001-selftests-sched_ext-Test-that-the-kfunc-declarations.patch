 .../selftests/sched_ext/compat_kfuncs.bpf.c   | 20 ++++
 .../selftests/sched_ext/compat_kfuncs.c       | 97 +++++++++++++++++++
 .../selftests/sched_ext/compat_kfuncs.h       | 86 ++++++++++++++++
 4 files changed, 204 insertions(+)
